# Runtime: the API's queries. Pooled in production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Prisma CLI: migrations. Must be direct. ?schema=app is what puts the
# tables (and _prisma_migrations) outside the Data API's reach.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=app"